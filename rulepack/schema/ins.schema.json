{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labelwise.in/schema/rulepack/ins.schema.json",
  "title": "INS-keyed additive records",
  "description": "Keyed on the INS integer, exploiting India's mandatory INS declaration (ADR-0005, FR-KB-06).",
  "type": "object",
  "required": ["additives"],
  "additionalProperties": false,
  "properties": {
    "additives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["insNumber","commonName","functionalClass","descriptionMessageId","evidenceStrength","sourceRefs","permittedInIndia"],
        "additionalProperties": false,
        "properties": {
          "insNumber": { "type": "integer", "minimum": 1, "maximum": 1999 },
          "commonName": { "type": "string", "minLength": 1 },
          "alternateNames": { "type": "array", "items": { "type": "string" } },
          "functionalClass": {
            "enum": ["ACIDITY_REGULATOR","ANTICAKING_AGENT","ANTIFOAMING_AGENT","ANTIOXIDANT","BULKING_AGENT",
                     "COLOUR","COLOUR_RETENTION_AGENT","EMULSIFIER","FIRMING_AGENT","FLAVOUR_ENHANCER",
                     "FLOUR_TREATMENT_AGENT","FOAMING_AGENT","GELLING_AGENT","GLAZING_AGENT","HUMECTANT",
                     "PRESERVATIVE","PROPELLANT","RAISING_AGENT","SEQUESTRANT","STABILISER","SWEETENER","THICKENER"]
          },
          "descriptionMessageId": { "$ref": "https://labelwise.in/schema/rulepack/common.schema.json#/$defs/messageId" },
          "evidenceStrength": { "enum": ["ESTABLISHED","LIMITED","CONTESTED"] },
          "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "https://labelwise.in/schema/rulepack/common.schema.json#/$defs/sourceId" } },
          "permittedInIndia": { "type": "boolean", "description": "Regulatory status is a Layer 1 fact, not advisory judgement." }
        }
      }
    }
  }
}
