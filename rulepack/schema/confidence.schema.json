{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Confidence assignment and invariant tolerances",
  "description": "S1/S2/S3 assignment plus tolerance bands, tunable from corpus calibration without a code change (ADR-0010). Tolerances govern invariants ONLY and must never enter parser accuracy measurement (ADR-0023).",
  "type": "object",
  "required": [
    "signalPriority",
    "assignment",
    "tolerances",
    "approximationDeltas"
  ],
  "additionalProperties": false,
  "properties": {
    "signalPriority": {
      "type": "array",
      "items": {
        "enum": [
          "S1_OCR",
          "S2_PARSE_STRENGTH",
          "S3_INVARIANTS"
        ]
      },
      "description": "Approved order is S3, S2, S1 (ADR-0010)."
    },
    "assignment": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "when",
          "result"
        ],
        "additionalProperties": false,
        "properties": {
          "when": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "parseStrength": {
                "$ref": "common.schema.json#/$defs/parseStrength"
              },
              "anyInvariantFailed": {
                "type": "boolean"
              },
              "ocrConfidenceAtLeast": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "ocrConfidenceAbsent": {
                "type": "boolean"
              },
              "anyInvariantIndeterminate": {
                "type": "boolean",
                "description": "May be recorded for explanation purposes. MUST NOT be used to lower confidence: INDETERMINATE is not evidence of error (ADR-0027)."
              }
            }
          },
          "result": {
            "$ref": "common.schema.json#/$defs/confidence"
          }
        }
      }
    },
    "tolerances": {
      "type": "array",
      "description": "Provisional until corpus-calibrated (Q14). Every band records how it was derived.",
      "items": {
        "type": "object",
        "required": [
          "invariantId",
          "mode",
          "calibrationBasis"
        ],
        "additionalProperties": false,
        "properties": {
          "invariantId": {
            "type": "string",
            "pattern": "^INV-\\d{2}$"
          },
          "mode": {
            "enum": [
              "EXACT",
              "ABSOLUTE",
              "RELATIVE",
              "RELATIVE_WITH_FLOOR"
            ]
          },
          "relativeFraction": {
            "type": "number",
            "minimum": 0
          },
          "absoluteFloor": {
            "$ref": "common.schema.json#/$defs/quantity"
          },
          "calibrationBasis": {
            "type": "string",
            "minLength": 10,
            "description": "REQUIRED. A tolerance with no recorded basis is indistinguishable from a guess and will be treated as one."
          },
          "calibratedAgainstCorpusVersion": {
            "type": "string"
          },
          "calibratedOn": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "approximationDeltas": {
      "type": "array",
      "description": "Half-width of the interval denoted by APPROXIMATELY, per unit (ADR-0027). Held as data so it is tunable from corpus calibration without a code change.",
      "items": {
        "type": "object",
        "required": [
          "unit",
          "delta",
          "basis"
        ],
        "additionalProperties": false,
        "properties": {
          "unit": {
            "$ref": "common.schema.json#/$defs/unit"
          },
          "delta": {
            "$ref": "common.schema.json#/$defs/quantity"
          },
          "basis": {
            "type": "string",
            "minLength": 10,
            "description": "REQUIRED. How this delta was derived."
          }
        }
      }
    }
  }
}
