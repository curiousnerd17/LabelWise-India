{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labelwise.in/schema/rulepack/synonyms.schema.json",
  "title": "Nutrient label synonym table (parser stage S5)",
  "description": "The highest-frequency contribution path in the project. A contributor adds a label variant without touching Dart (FR-KB-12).",
  "type": "object",
  "required": ["entries"],
  "additionalProperties": false,
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nutrient","patterns","expectedUnits"],
        "additionalProperties": false,
        "properties": {
          "nutrient": { "$ref": "https://labelwise.in/schema/rulepack/common.schema.json#/$defs/nutrientId" },
          "patterns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["text","strength"],
              "additionalProperties": false,
              "properties": {
                "text": { "type": "string", "minLength": 1 },
                "strength": { "$ref": "https://labelwise.in/schema/rulepack/common.schema.json#/$defs/parseStrength" },
                "caseSensitive": { "type": "boolean", "default": false },
                "notes": { "type": "string" }
              }
            }
          },
          "expectedUnits": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "https://labelwise.in/schema/rulepack/common.schema.json#/$defs/unit" },
            "description": "A unit outside this set lowers confidence rather than failing the parse."
          }
        }
      }
    }
  }
}
