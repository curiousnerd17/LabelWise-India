{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labelwise.in/schema/rulepack/thresholds.schema.json",
  "title": "Layer 2 advisory threshold rules",
  "description": "Anchored on WHO SEARO plus ICMR-NIN (ADR-0004). Every rule carries at least one citation or validation fails (FR-KB-04).",
  "type": "object",
  "required": ["rules"],
  "additionalProperties": false,
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ruleId","ruleVersion","nutrient","basis","comparator","threshold","classification","sourceRefs","messageId"],
        "additionalProperties": false,
        "properties": {
          "ruleId": { "$ref": "https://labelwise.in/schema/rulepack/common.schema.json#/$defs/ruleId" },
          "ruleVersion": { "$ref": "https://labelwise.in/schema/rulepack/common.schema.json#/$defs/version" },
          "nutrient": { "$ref": "https://labelwise.in/schema/rulepack/common.schema.json#/$defs/nutrientId" },
          "basis": { "$ref": "https://labelwise.in/schema/rulepack/common.schema.json#/$defs/basis" },
          "comparator": { "enum": ["GTE","GT","LTE","LT"] },
          "threshold": { "$ref": "https://labelwise.in/schema/rulepack/common.schema.json#/$defs/quantity" },
          "classification": { "enum": ["LOW","MODERATE","HIGH_IN"] },
          "severityWeight": { "type": "number", "minimum": 0, "description": "Input to ranking (FR-L2-08). Severity derives from the recorded margin." },
          "categorySelector": { "$ref": "https://labelwise.in/schema/rulepack/common.schema.json#/$defs/categorySelector" },
          "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "https://labelwise.in/schema/rulepack/common.schema.json#/$defs/sourceId" } },
          "messageId": { "$ref": "https://labelwise.in/schema/rulepack/common.schema.json#/$defs/messageId" }
        }
      }
    }
  }
}
