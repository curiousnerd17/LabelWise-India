{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labelwise.in/schema/rulepack/rda.schema.json",
  "title": "FSSAI RDA denominators (Layer 1)",
  "description": "Gazetted denominators for percent-RDA arithmetic (FR-L1-04). Held as data because regulation changes (A5, R5).",
  "type": "object",
  "required": ["denominators"],
  "additionalProperties": false,
  "properties": {
    "denominators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["constantId","nutrient","value","sourceRefs"],
        "additionalProperties": false,
        "properties": {
          "constantId": { "type": "string", "pattern": "^const\\.[a-z0-9_.-]+$" },
          "nutrient": { "$ref": "https://labelwise.in/schema/rulepack/common.schema.json#/$defs/nutrientId" },
          "value": { "$ref": "https://labelwise.in/schema/rulepack/common.schema.json#/$defs/quantity" },
          "sourceRefs": {
            "type": "array", "minItems": 1,
            "items": { "$ref": "https://labelwise.in/schema/rulepack/common.schema.json#/$defs/sourceId" }
          }
        }
      }
    }
  }
}
