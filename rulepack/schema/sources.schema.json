{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labelwise.in/schema/rulepack/sources.schema.json",
  "title": "Source citation registry",
  "description": "Every advisory claim in the product terminates here (FR-KB-04, FR-KB-05, P8).",
  "type": "object",
  "required": ["sources"],
  "additionalProperties": false,
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sourceId","title","publisher","publicationDate","accessDate","sourceType","evidenceStrength"],
        "additionalProperties": false,
        "properties": {
          "sourceId": { "$ref": "https://labelwise.in/schema/rulepack/common.schema.json#/$defs/sourceId" },
          "title": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string", "minLength": 1 },
          "publicationDate": { "type": "string" },
          "accessDate": { "type": "string", "format": "date" },
          "url": { "type": "string", "format": "uri" },
          "sourceType": { "enum": ["REGULATION","WHO_MODEL","PEER_REVIEWED","GOVERNMENT_GUIDANCE"] },
          "evidenceStrength": {
            "enum": ["ESTABLISHED","LIMITED","CONTESTED"],
            "description": "Allows additive commentary to say the evidence is contested rather than implying uniform certainty (FR-KB-07, P1)."
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
